#
# Please avoid changing the Qualcomm defconfig files and use this file to
# add any Motorola-specific configuration changes that are applicable to
# userdebug, eng, and user builds.
#
CONFIG_TANK_DTB=y
CONFIG_UFSFEATURE=y
CONFIG_UFSHID=y
CONFIG_UFSHID_POC=n
CONFIG_UFSHID_DEBUG=n
CONFIG_UFSSID=n
CONFIG_MICRON_UFSHID=y
CONFIG_SCSI_SKHID=y
CONFIG_SCHED_MOTO_UNFAIR=m

# Storage
CONFIG_MMC_SDHCI_MSM=m
CONFIG_SCSI_UFS_QCOM=m

# Fix Duplicate Symbols
CONFIG_UFSHCD_TRACE=n

# IOMMU
CONFIG_ARM_SMMU=m
CONFIG_ARM_SMMU_QCOM=y

# Memory Management
CONFIG_ZRAM_WRITEBACK=y


